“use client”;

import { useEffect, useState } from “react”;
import Link from “next/link”;
import { useRouter } from “next/navigation”;
import { createClient } from “@/lib/supabase/client”;

export default function ProfilePage() {
const supabase = createClient();
const router = useRouter();

const [loading, setLoading] = useState(true);
const [email, setEmail] = useState<string | null>(null);
const [userId, setUserId] = useState<string | null>(null);
const [errorMessage, setErrorMessage] = useState(””);

useEffect(() => {
async function loadProfile() {
const { data, error } = await supabase.auth.getUser();

  if (error || !data.user) {
    setEmail(null);
    setUserId(null);
  } else {
    setEmail(data.user.email ?? null);
    setUserId(data.user.id);
  }
  setLoading(false);
}
loadProfile();

}, [supabase]);

async function handleSignOut() {
setErrorMessage(””);

const { error } = await supabase.auth.signOut();
if (error) {
  setErrorMessage("Could not sign out. Please try again.");
  return;
}
router.push("/login");
router.refresh();

}

if (loading) {
return (
Loading your profile…
);
}

return (
LOUDEFOOT
      <h1 className="mt-2 text-3xl font-extrabold text-white sm:text-4xl">
        My Profile
      </h1>
      <p className="mt-2 text-sm text-[var(--muted)]">
        Manage your account and marketplace activity.
      </p>
    </div>
    <section className="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 sm:p-8">
      <div className="flex items-center gap-4">
        <div className="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[var(--primary)] text-2xl font-extrabold text-white">
          {email ? email.charAt(0).toUpperCase() : "L"}
        </div>
        <div className="min-w-0">
          <h2 className="text-lg font-bold text-white">
            {email ? "Welcome back!" : "Welcome to LOUDEFOOT"}
          </h2>
          <p className="mt-1 break-all text-sm text-[var(--muted)]">
            {email ?? "Sign in to access your account."}
          </p>
          <p className="mt-2 text-xs font-semibold text-[var(--accent)]">
            {email ? "Signed in" : "Guest"}
          </p>
        </div>
      </div>
      <div className="my-6 border-t border-[var(--border)]" />
      <div className="space-y-3">
        {email ? (
          <>
            <Link
              href="/my-listings"
              className="flex items-center justify-between rounded-xl border border-[var(--border)] bg-[#101d43] p-4 text-sm font-semibold text-white transition hover:border-[var(--primary)]"
            >
              <span>My Listings</span>
              <span className="text-[var(--accent)]">→</span>
            </Link>
            <Link
              href="/sell"
              className="flex items-center justify-between rounded-xl border border-[var(--border)] bg-[#101d43] p-4 text-sm font-semibold text-white transition hover:border-[var(--primary)]"
            >
              <span>Sell an Account</span>
              <span className="text-[var(--accent)]">→</span>
            </Link>
            <Link
              href="/accounts"
              className="flex items-center justify-between rounded-xl border border-[var(--border)] bg-[#101d43] p-4 text-sm font-semibold text-white transition hover:border-[var(--primary)]"
            >
              <span>Browse Accounts</span>
              <span className="text-[var(--accent)]">→</span>
            </Link>
            <button
              type="button"
              onClick={handleSignOut}
              className="w-full rounded-xl border border-red-500/40 px-4 py-3 text-sm font-bold text-red-300 transition hover:bg-red-500/10"
            >
              Sign Out
            </button>
          </>
        ) : (
          <>
            <Link
              href="/login"
              className="btn btn-primary flex w-full items-center justify-center px-5 py-3 text-sm"
            >
              Log In
            </Link>
            <Link
              href="/signup"
              className="btn btn-secondary flex w-full items-center justify-center px-5 py-3 text-sm"
            >
              Create an Account
            </Link>
            <Link
              href="/accounts"
              className="block rounded-xl border border-[var(--border)] p-4 text-center text-sm font-semibold text-white transition hover:border-[var(--primary)]"
            >
              Browse Accounts
            </Link>
          </>
        )}
      </div>
      {errorMessage && (
        <p role="alert" className="mt-4 text-sm text-red-400">
          {errorMessage}
        </p>
      )}
    </section>
    <p className="mt-5 text-center text-xs leading-relaxed text-[var(--muted)]">
      Keep your login details private and verify account information before
      arranging a transaction.
    </p>
  </div>
</main>

);
} 